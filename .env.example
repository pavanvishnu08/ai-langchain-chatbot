# Copy this file to ".env" and fill in your values. All options are free.

# "groq" (default, hosted, free tier) or "ollama" (local, offline, free)
LLM_PROVIDER=groq

# Only needed if LLM_PROVIDER=groq
# Get a free key (no credit card) at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=llama3.1
